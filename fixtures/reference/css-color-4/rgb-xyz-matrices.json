  "meta": {
    "id": "css-color-4-rgb-xyz-matrices",
    "source": "CSS Color Module Level 4, sample code for color conversions: lin_sRGB_to_XYZ, XYZ_to_lin_sRGB, lin_P3_to_XYZ, XYZ_to_lin_P3, lin_a98rgb_to_XYZ, XYZ_to_lin_a98rgb, lin_ProPhoto_to_XYZ, XYZ_to_lin_ProPhoto, lin_2020_to_XYZ, XYZ_to_lin_2020",
    "edition": "W3C Candidate Recommendation Draft, 26 September 2026",
    "url": "https://www.w3.org/TR/css-color-4/",
    "retrieved": "2026-09-28",
    "license": "W3C Software and Document License (sample code)",
    "values_precision": "Exact rationals, except ProPhoto RGB which is published as 64-bit decimals (w3c/csswg-drafts#7675). The rec2020 element [2][0] is published as 0 although its computed value is 4.994106574466076e-17.",
    "tolerance": {
      "abs": 1e-14,
      "rationale": "The library computes each matrix from the 4-digit (ProPhoto: 6-digit) primaries and white (SMPTE RP 177) instead of using the literals. Forward matrices differ by at most a few ulp (measured max 3.3e-16); inverses computed by Matrix3::inverse() add a few more (measured max 1.8e-15, elements up to ~3.3). 1e-14 keeps a 5x margin while still catching a wrong primary in the 4th digit (which changes elements by ~1e-4)."
    }
  },
